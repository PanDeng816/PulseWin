<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        工具窗亮色主题(设置/统计/会话窗共用)。对齐上游设置窗的 mac 原生观感。
        色值与 Rendering\Theme.cs 的 LightPalette 一一对应,两边不要漂。
    -->

    <Color x:Key="AccentColor">#007AFF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#007AFF"/>
    <SolidColorBrush x:Key="AccentPressBrush" Color="#0064D2"/>
    <SolidColorBrush x:Key="WindowBackBrush" Color="#FFFFFF"/>
    <!-- 窗口壳底色:玻璃开时被 UiTheme.ApplyGlass 改写成 Transparent(让 DWM 材质透出来),
         关时 = 页面底色。只给 Window.Background 用,别当普通底色。 -->
    <SolidColorBrush x:Key="ShellBackBrush" Color="#F4F4F7"/>
    <!-- 页面底与卡片分开:白卡压在浅灰底上,层次靠"底色差 + 一圈极淡投影",
         不再靠一条 1px 灰线(那种画法在 200% DPI 下几乎看不见)。 -->
    <SolidColorBrush x:Key="PageBackBrush" Color="#F4F4F7"/>
    <SolidColorBrush x:Key="SidebarBackBrush" Color="#F4F4F7"/>
    <SolidColorBrush x:Key="CardBackBrush" Color="#FFFFFF"/>
    <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="1" Direction="270"
                      Opacity="0.055" Color="#000000"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="TextSubBrush" Color="#86868B"/>
    <SolidColorBrush x:Key="TextGroupBrush" Color="#8E8E93"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E8E8EC"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#ECECEF"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#E9E9EC"/>
    <SolidColorBrush x:Key="NavActiveBackBrush" Color="#E7F1FF"/>
    <SolidColorBrush x:Key="FieldBackBrush" Color="#F0F0F2"/>
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#D8D8DC"/>
    <!-- 以下键在 Themes\Dark.xaml 里有同名覆盖:两边的键名必须一一对应 -->
    <SolidColorBrush x:Key="TileBackBrush" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="SegBackBrush" Color="#EBEBEF"/>
    <SolidColorBrush x:Key="SegHoverBrush" Color="#E0E0E4"/>
    <SolidColorBrush x:Key="TabActiveBackBrush" Color="#E9F2FF"/>
    <SolidColorBrush x:Key="TabActiveTextBrush" Color="#0068D9"/>
    <SolidColorBrush x:Key="ChipBackBrush" Color="#EAF2FF"/>
    <SolidColorBrush x:Key="BarTrackBrush" Color="#ECECF0"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#C7502E"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C9C9D0"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#AFAFB8"/>
    <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#96969F"/>
    <SolidColorBrush x:Key="ComboHoverBorderBrush" Color="#B9B9BF"/>
    <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#C9C9CF"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#B3D7FF"/>

    <!-- 次要按钮:白底灰边。主按钮:蓝底白字。 -->
    <Style x:Key="LightButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource CardBackBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SeparatorBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource LightButton}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentPressBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#0058B8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LightTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource CardBackBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="#B3D7FF"/>
        <!-- 垂直 padding 只能用 2:模板里 ScrollViewer 的高度 = 控件高 − 边框 − 上下 padding,
             12.5pt 中文字行高约 33px,30px 高的控件扣掉 2+2*4 只剩 20px,居中后上下各裁 ~6px,
             **句点正落在被裁掉的降部区**——"7.2" 会显示成 "7 2"。降到 2 后内容区 24px,句点完整。 -->
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 勾选框:18px 圆角方块,选中蓝底白勾。 -->
    <Style x:Key="LightCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="5"
                                Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource FieldBorderBrush}"
                                BorderThickness="1" VerticalAlignment="Center">
                            <Path x:Name="check" Data="M3,8.2 L6.8,12 L13,4.6" Stroke="White" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="check" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下拉:白底灰边圆角,弹层白卡带阴影。替代旧 DarkCombo。 -->
    <Style x:Key="LightComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LightCombo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource LightComboItem}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource FieldBorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="9,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1" Data="M0,0 L4,4 8,0" Stroke="{DynamicResource TextSubBrush}" StrokeThickness="1.5"
                                                  VerticalAlignment="Center" Margin="6,1,0,0"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ComboHoverBorderBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="selected" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="10,0,26,0" VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" AllowsTransparency="True" StaysOpen="False"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource CardBackBrush}" CornerRadius="8" BorderBrush="{DynamicResource SegHoverBrush}"
                                    BorderThickness="1" Margin="10,4,10,12" Padding="4" MinWidth="{TemplateBinding ActualWidth}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                                      Opacity="0.22" Color="#000000"/>
                                </Border.Effect>
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 滑杆:4px 细轨道,蓝填充,白圆钮带边。 -->
    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse Width="18" Height="18" Fill="White" Stroke="{DynamicResource SliderThumbBorderBrush}" StrokeThickness="1">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.3" Color="#000000"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LightSlider" TargetType="Slider">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource FieldBorderBrush}"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumbStyle}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 滚动条:系统默认那条深灰粗轨在浅色窗里像一道裂缝(实测 200% DPI 下宽 17px)。
         这里只留 10px 透明轨道 + 圆角淡灰滑块,无箭头;垂直/水平各一套布局。
         **用隐式样式挂进 App 资源**,否则每个 ScrollViewer 都要单独写模板。 -->
    <Style x:Key="LightScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="thumb" Background="{DynamicResource ScrollThumbBrush}" CornerRadius="3"
                                                    Margin="1,2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="thumb" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="thumb" Property="Background" Value="{DynamicResource ScrollThumbDragBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="thumb" Background="{DynamicResource ScrollThumbBrush}" CornerRadius="3"
                                                            Margin="2,1"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="thumb" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 全局默认滚动条(隐式):所有 ScrollViewer / 列表 / TextBox 内部都走这套细滑块 -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource LightScrollBar}"/>

    <!-- 自定义区间用的日期框:系统模板是白底黑字,深色主题下会跳出来两块白。
         这里只改配色(模板仍用系统默认),日期文本与边框跟主题走。 -->
    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{DynamicResource CardBackBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="{DynamicResource CardBackBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
    </Style>

    <!-- 悬停提示(全局隐式):系统默认模板是直角灰框,和整窗的圆角卡片完全两个时代。
         换成 mac 风格小卡片:8px 圆角 + 1px 浅描边 + 一层很淡的投影,并固定与主界面同一套字体
         (ToolTip 是弹出层,不继承窗口的 FontFamily,不设就会掉回系统默认字体)。
         深色主题在 Themes\Dark.xaml 覆盖 Tip 三个键。 -->
    <SolidColorBrush x:Key="TipBackBrush" Color="#FCFCFD"/>
    <SolidColorBrush x:Key="TipBorderBrush" Color="#DCDCE1"/>
    <DropShadowEffect x:Key="TipShadow" BlurRadius="12" ShadowDepth="2" Direction="270"
                      Opacity="0.10" Color="#000000"/>

    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="MaxWidth" Value="340"/>
        <!-- 出现在鼠标右下方,别压住正在看的那根柱子;贴近屏幕边缘时 WPF 会自动翻转 -->
        <Setter Property="Placement" Value="Mouse"/>
        <Setter Property="HorizontalOffset" Value="12"/>
        <Setter Property="VerticalOffset" Value="18"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Grid Margin="8">
                        <Border Background="{DynamicResource TipBackBrush}"
                                BorderBrush="{DynamicResource TipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Effect="{DynamicResource TipShadow}">
                            <ContentPresenter TextElement.Foreground="{DynamicResource TextBrush}"
                                              TextElement.FontFamily="Segoe UI, Microsoft YaHei UI"
                                              TextElement.FontSize="11.5"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
