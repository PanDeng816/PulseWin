<Window x:Class="PulseWin.BrowserLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="登录" Width="560" Height="800"
        MinWidth="440" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">

    <!-- 通用的内嵌 WebView2 登录窗:登录一次,之后 cookie 由 DPAPI 落盘长期复用。
         目标站由构造参数 BrowserLoginTarget 决定(见 Services\BrowserLoginTargets.cs);
         存在的理由见 code-behind 顶部注释(读本机浏览器 cookie 库已被 v20 加密堵死)。 -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,10">
            <TextBlock x:Name="HeadingText" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock x:Name="StatusText" Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSubBrush}"
                       Text="正在载入登录页…"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="16,0" BorderThickness="1" CornerRadius="6"
                BorderBrush="{StaticResource CardBorderBrush}" ClipToBounds="True">
            <wv2:WebView2 x:Name="View"/>
        </Border>

        <Grid Grid.Row="2" Margin="16,10,16,14">
            <TextBlock MaxWidth="330" HorizontalAlignment="Left" VerticalAlignment="Center"
                       FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSubBrush}"
                       Text="登录成功后本窗口自动关闭,cookie 会加密保存到本机;会话过期时再点一次登录即可。"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="RestartButton" Style="{StaticResource LightButton}" Content="重新载入"
                        Padding="12,5" Click="Restart_Click"/>
                <Button x:Name="CancelButton" Style="{StaticResource PrimaryButton}" Content="取消"
                        Padding="14,5" Margin="8,0,0,0" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
