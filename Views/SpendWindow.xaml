<Window x:Class="PulseWin.SpendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PulseWin"
        Title="Pulse 用量" Width="640" Height="780" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource PageBackBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">

    <Window.Resources>
        <!-- 亮色主题,对齐上游 Token spend 页:白底、白卡、蓝控件、灰注释 -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource FieldBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SegHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 区间/视图切换:上游分段控件样式(浅灰轨道、选中蓝块白字) -->
        <Style x:Key="SpanToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource SegBackBrush}" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SegHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="7" ShadowDepth="1" Direction="270"
                                                          Opacity="0.18" Color="#007AFF"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 视图页签:导航用,一眼能分出"当前在哪个视图"。浅蓝底 + 强调色文字,
             与下面那排"区间筛选"(实心蓝块)拉开权重——两者管的事不同。 -->
        <Style x:Key="ViewTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#6E6E73"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2F2F5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabActiveBackBrush}"/>
                                <Setter Property="Foreground" Value="#0068D9"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="{DynamicResource SpendCardPad}"/>
            <Setter Property="Margin" Value="{DynamicResource SpendCardGap}"/>
            <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="{DynamicResource SpendSectionMargin}"/>
        </Style>

        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSubBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 列表行:名称 / 数字 / 金额 / 比例条。可下钻的行(最近会话)显手型光标 -->
        <DataTemplate x:Key="RowTemplate">
            <Grid Margin="{DynamicResource RowGap}" Background="Transparent" MouseLeftButtonDown="Row_MouseDown"
                  Cursor="{Binding RowCursor}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <!-- 说明文字放星号列:窄窗口(默认 640)下不至于被硬裁出半个字 -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 外层裁剪:BarWidth 算大了(满格归一/取整)时填充条也不会糊出 180 的底轨,
                             而在整行上拉一条长线 -->
                        <Border Background="{DynamicResource BarTrackBrush}" CornerRadius="2.5" Height="5" Width="180"
                                HorizontalAlignment="Left" ClipToBounds="True">
                            <Border Background="{Binding BarBrush}" CornerRadius="2.5" Height="5"
                                    HorizontalAlignment="Left" Width="{Binding BarWidth}" MaxWidth="180"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextSubBrush}"
                                   Margin="8,-3,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Detail}"/>
                    </Grid>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Tokens}" FontSize="13" VerticalAlignment="Top"
                           HorizontalAlignment="Right" Margin="0,0,12,0" ToolTip="{Binding TokensTip}"
                           Typography.NumeralAlignment="Tabular"/>
                <TextBlock Grid.Column="2" Text="{Binding Amount}" FontSize="13" VerticalAlignment="Top"
                           HorizontalAlignment="Right" MinWidth="64" TextAlignment="Right"
                           ToolTip="{Binding AmountTip}" Typography.NumeralAlignment="Tabular"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部:视图 tab / 区间 / 刷新与导出 / 价目表来源 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackBrush}" Padding="20,13,20,11"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
            <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">
                <WrapPanel x:Name="TabRow" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SpanToday" Style="{StaticResource SpanToggle}" Content="今天" GroupName="Span" Tag="Today"/>
                    <RadioButton x:Name="SpanWeek" Style="{StaticResource SpanToggle}" Content="近 7 天" GroupName="Span" Tag="Week"/>
                    <RadioButton x:Name="SpanMonth" Style="{StaticResource SpanToggle}" Content="近 30 天" GroupName="Span" Tag="Month"/>
                    <RadioButton x:Name="SpanCustom" Style="{StaticResource SpanToggle}" Content="自定义" GroupName="Span" Tag="Custom"
                                 Checked="SpanCustom_Checked" Unchecked="SpanCustom_Unchecked"/>
                    <RadioButton x:Name="SpanAll" Style="{StaticResource SpanToggle}" Content="全部" GroupName="Span" Tag="All"/>
                    <Button x:Name="RefreshButton" Style="{StaticResource DarkButton}" Content="重新读取" Click="Refresh_Click"/>
                    <Button x:Name="ExportButton" Style="{StaticResource DarkButton}" Content="导出" Click="Export_Click"
                            Margin="4,0,0,0"/>
                </StackPanel>
                <!-- 自定义区间(选"自定义"才展开) -->
                <StackPanel x:Name="CustomRangePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,8,0,0">
                    <TextBlock Text="从" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="CustomFrom" Width="130"/>
                    <TextBlock Text="到" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="8,0,6,0"/>
                    <DatePicker x:Name="CustomTo" Width="130"/>
                    <Button x:Name="CustomApply" Style="{StaticResource DarkButton}" Content="应用" Click="CustomApply_Click"
                            Margin="8,0,0,0" Padding="16,3"/>
                </StackPanel>
                <TextBlock x:Name="PriceSourceText" Style="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel Margin="20,14,20,18" MaxWidth="1280" HorizontalAlignment="Stretch">

                <!-- 下钻面包屑(点柱图/热图某天后出现) -->
                <DockPanel x:Name="DayFilterRow" Visibility="Collapsed" Margin="{DynamicResource SpendCardGap}">
                    <Button x:Name="DayFilterBack" DockPanel.Dock="Left" Style="{StaticResource DarkButton}"
                            Content="← 返回" Click="DayFilterBack_Click" Padding="10,3"/>
                    <TextBlock x:Name="DayFilterText" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="12.5" FontWeight="SemiBold"/>
                </DockPanel>

                <!-- ============ 总览视图 ============ -->
                <StackPanel x:Name="OverviewPanel">

                    <!-- 订阅额度:每个订阅一行,回答"还剩多少、什么时候重置" -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="订阅额度" Style="{StaticResource SectionTitle}"/>
                            <StackPanel x:Name="QuotaPanel"/>
                            <TextBlock x:Name="QuotaHint" Style="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 总计 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TotalTokens" FontSize="34" FontWeight="SemiBold"
                                           VerticalAlignment="Bottom" Typography.NumeralAlignment="Tabular"/>
                                <TextBlock Text="tokens" FontSize="12.5" Foreground="{DynamicResource TextSubBrush}" Margin="8,0,0,9"/>
                                <TextBlock x:Name="TotalCost" FontSize="34" FontWeight="SemiBold" Margin="30,0,0,0"
                                           VerticalAlignment="Bottom" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                            <TextBlock x:Name="DeltaLine" Style="{StaticResource Dim}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="CostNote" Style="{StaticResource Dim}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TallyLine" Style="{StaticResource Dim}" Margin="0,9,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ScopeLine" Style="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 活动热图:不受区间选择影响,永远画仓库/源库覆盖到的全部日子 -->
                    <TextBlock Text="活动热图" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}" Padding="14,12,14,8">
                        <StackPanel>
                            <local:HeatmapView x:Name="Heatmap" Height="118" ClipToBounds="True"/>
                            <TextBlock x:Name="HeatHint" Style="{StaticResource Dim}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 每日柱状图 -->
                    <TextBlock Text="每日用量" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}" Padding="14,12,14,8">
                        <StackPanel>
                            <Canvas x:Name="ChartCanvas" Height="132" ClipToBounds="True"/>
                            <TextBlock x:Name="ChartHint" Style="{StaticResource Dim}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 最近对话:最近 6 个会话各用了多少 token,点一行下钻到会话详情。
                         区间里一个对话都没有时整块收起,不留空卡。 -->
                    <StackPanel x:Name="RecentSessionSection">
                        <TextBlock Text="最近对话" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ItemsControl x:Name="RecentSessionList" ItemTemplate="{StaticResource RowTemplate}"/>
                                <!-- 其余会话合计:让"6 行"与顶部总量能对上,而不是两套数字各说各的 -->
                                <TextBlock x:Name="RecentSessionMore" Margin="0,8,0,0" FontSize="11"
                                           Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 构成与明细:模型 / 来源 / 项目 合并成一张卡,分段切换
                         (原来四张卡各占一屏,合并后省掉大半的纵向滚动) -->
                    <TextBlock Text="构成与明细" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="BreakdownModels" Style="{StaticResource SpanToggle}" Content="模型"
                                             GroupName="Breakdown" Tag="Models" Checked="Breakdown_Checked"/>
                                <RadioButton x:Name="BreakdownAgents" Style="{StaticResource SpanToggle}" Content="来源"
                                             GroupName="Breakdown" Tag="Agents" Checked="Breakdown_Checked"/>
                                <RadioButton x:Name="BreakdownProjects" Style="{StaticResource SpanToggle}" Content="项目"
                                             GroupName="Breakdown" Tag="Projects" Checked="Breakdown_Checked"/>
                            </StackPanel>
                            <ItemsControl x:Name="ModelList" ItemTemplate="{StaticResource RowTemplate}"/>
                            <ItemsControl x:Name="AgentList" ItemTemplate="{StaticResource RowTemplate}" Visibility="Collapsed"/>
                            <ItemsControl x:Name="ProjectList" ItemTemplate="{StaticResource RowTemplate}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ModelHint" Style="{StaticResource Dim}" Margin="0,-8,0,14" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- ============ 单套餐视图 ============ -->
                <StackPanel x:Name="ChannelPanel" Visibility="Collapsed">

                    <!-- 概要与 KPI -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="ChannelTitle" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ChannelSubtitle" Style="{StaticResource Dim}" Margin="0,3,0,0"/>
                            <UniformGrid x:Name="ChannelKpiGrid" Columns="3" Margin="0,12,0,2"/>
                            <Border Background="{DynamicResource SeparatorBrush}" Height="1" Margin="0,10,0,10"/>
                            <TextBlock Text="Token 构成" Style="{StaticResource SectionTitle}" Margin="1,0,0,0"/>
                            <UniformGrid x:Name="ChannelTokenGrid" Columns="3" Margin="0,4,0,2"/>
                        </StackPanel>
                    </Border>

                    <!-- 这个套餐的订阅额度(有配额快照的渠道才有内容) -->
                    <Border x:Name="ChannelQuotaCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="订阅额度" Style="{StaticResource SectionTitle}"/>
                            <StackPanel x:Name="ChannelQuotaPanel"/>
                            <TextBlock x:Name="ChannelQuotaHint" Style="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 官方口径对照(每个套餐一张,内容按渠道能拿到的官方读数生成):
                         GOAT = 官方账期 vs 本机(差值是其他设备/CLI);DeepSeek = 官方余额 vs 本机;
                         OpenCode Go = 官方只给百分比、本机给 token;BigModel = 手填预算 vs 本机估算 -->
                    <Border x:Name="AccountMeterCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="AccountMeterTitle" Text="官方口径对照" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="AccountMeterHint" Style="{StaticResource Dim}" Margin="0,-2,0,8" TextWrapping="Wrap"/>
                            <UniformGrid x:Name="AccountMeterGrid" Columns="3" Margin="0,0,0,2"/>
                            <!-- 只有 GOAT 与 OpenCode Go 有账号级用量接口(GOAT 走 charts,
                                 OpenCode 走 console api/usage/*);别的渠道这块折叠 -->
                            <StackPanel x:Name="AccountModelSection">
                                <Border Background="{DynamicResource SeparatorBrush}" Height="1" Margin="0,10,0,10"/>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="官方逐模型明细(账号级)" Style="{StaticResource SectionTitle}" Margin="0"/>
                                </Grid>
                                <TextBlock x:Name="AccountModelHint" Style="{StaticResource Dim}" Margin="0,-4,0,8" TextWrapping="Wrap"/>
                                <ItemsControl x:Name="AccountModelList" ItemTemplate="{StaticResource RowTemplate}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 时段分布:今天 / 整个区间 两档共用一张卡(原来两张卡画的是同一件事,
                         只是时间窗不同;合并后少一张卡、少一次滚动)。峰谷着色的柱子换成曲线 + 浅色底纹 -->
                    <Border x:Name="ChannelPeakCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock x:Name="ChannelPeakTitle" Text="时段分布" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <RadioButton x:Name="HourToday" Style="{StaticResource SpanToggle}" Content="今天"
                                                 GroupName="HourScope" Tag="Today" Padding="8,3" FontSize="11"
                                                 Checked="HourScope_Checked"/>
                                    <RadioButton x:Name="HourRange" Style="{StaticResource SpanToggle}" Content="整个区间"
                                                 GroupName="HourScope" Tag="Range" Padding="8,3" FontSize="11" Margin="0"
                                                 Checked="HourScope_Checked"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="HourTodayPanel">
                                <TextBlock x:Name="ChannelTodayHint" Style="{StaticResource Dim}" Margin="0,-2,0,8" TextWrapping="Wrap"/>
                                <Border x:Name="ChannelHourBox" Height="110" Background="Transparent"/>
                            </StackPanel>
                            <StackPanel x:Name="HourRangePanel" Visibility="Collapsed">
                                <TextBlock x:Name="ChannelPeakHint" Style="{StaticResource Dim}" Margin="0,-2,0,8" TextWrapping="Wrap"/>
                                <UniformGrid x:Name="ChannelPeakGrid" Columns="3" Margin="0,0,0,8"/>
                                <Border x:Name="ChannelRangeHourBox" Height="110" Background="Transparent" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 性能与行为 -->
                    <Border x:Name="ChannelPerfCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="性能与行为" Style="{StaticResource SectionTitle}"/>
                            <UniformGrid x:Name="ChannelPerfGrid" Columns="3" Margin="0,4,0,2"/>
                        </StackPanel>
                    </Border>

                    <!-- 每日用量 -->
                    <Border x:Name="ChannelDailyCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="每日用量" Style="{StaticResource SectionTitle}"/>
                            <Border x:Name="ChannelDailyBox" Height="110" Background="Transparent" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 模型分布(可按 token / 金额排序) -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="各模型用量" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <RadioButton x:Name="ModelSortTokens" Style="{StaticResource SpanToggle}" Content="按 token"
                                                 GroupName="ModelSort" Padding="8,3" FontSize="11"
                                                 Checked="ModelSort_Checked"/>
                                    <RadioButton x:Name="ModelSortCost" Style="{StaticResource SpanToggle}" Content="按金额"
                                                 GroupName="ModelSort" Padding="8,3" FontSize="11" Margin="0"
                                                 Checked="ModelSort_Checked"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="ChannelModelPanel"/>
                        </StackPanel>
                    </Border>

                    <!-- 逐日明细(模型 × 天) -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="逐日明细" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="ChannelDailyTableHint" Style="{StaticResource Dim}" Margin="0,-2,0,6"/>
                            <StackPanel x:Name="ChannelDailyTablePanel"/>
                        </StackPanel>
                    </Border>

                    <!-- 归属信息:只是一行元数据,不再单占一张卡(并到页脚区) -->
                    <TextBlock x:Name="ChannelMetaLine" Style="{StaticResource Dim}" Margin="1,0,0,10" TextWrapping="Wrap"/>

                    <TextBlock x:Name="ChannelStatusLine" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                </StackPanel>

                <TextBlock x:Name="Footnote" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
