<Window x:Class="PulseWin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PulseWin"
        Title="PulseWin 设置" Width="860" Height="600" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#F5F5F7" Foreground="#1D1D1F"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">

    <!-- 亮色主题,对齐上游设置窗:左侧分页导航 + 右侧内容,行 = 左标题副标题/右控件,
         分组白卡 + hairline。控件样式来自 Themes/Light.xaml。 -->

    <Window.Resources>
        <!-- 侧栏导航项:选中蓝底白字,hover 浅灰。图标用系统 Segoe MDL2。 -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="11,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="icon" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Margin="0,1,10,0"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#6E6E73"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E9E9EC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#007AFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="icon" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧栏分组小标签 -->
        <Style x:Key="NavGroup" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="Margin" Value="12,16,0,5"/>
        </Style>

        <!-- 页内分节标题 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="Margin" Value="1,0,0,8"/>
        </Style>

        <!-- 分组白卡 -->
        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3E3E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,4"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- 行:左标题+副标题,右控件 -->
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
        </Style>
        <Style x:Key="RowSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#86868B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#86868B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RowSeparator" TargetType="Border">
            <Setter Property="Background" Value="#E8E8EC"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="-16,10"/>
        </Style>

        <!-- 滑杆行右侧的值标签 -->
        <Style x:Key="SliderValue" TargetType="TextBlock">
            <Setter Property="Width" Value="44"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ————— 侧栏 ————— -->
        <Border Grid.Column="0" Background="#F5F5F7" BorderBrush="#E3E3E6" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,14,12,14">
                    <TextBlock Text="面板" Style="{StaticResource NavGroup}" Margin="12,2,0,5"/>
                    <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" Tag="&#xE790;"
                                 GroupName="nav" IsChecked="True" Content="外观" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavRings" Style="{StaticResource NavItem}" Tag="&#xE9D9;"
                                 GroupName="nav" Content="圆环与数字" Checked="Nav_Checked"/>
                    <TextBlock Text="数据" Style="{StaticResource NavGroup}"/>
                    <RadioButton x:Name="NavSources" Style="{StaticResource NavItem}" Tag="&#xE772;"
                                 GroupName="nav" Content="数据源" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavRefresh" Style="{StaticResource NavItem}" Tag="&#xE777;"
                                 GroupName="nav" Content="刷新" Checked="Nav_Checked"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ————— 内容区 ————— -->
        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitle" Text="外观" FontSize="22" FontWeight="Bold"
                       Foreground="#1D1D1F" Margin="34,24,34,14"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <StackPanel Margin="34,0,34,26" TextElement.FontFamily="Segoe UI, Microsoft YaHei UI">

                    <!-- ============ 外观 ============ -->
                    <StackPanel x:Name="PageAppearance">
                        <TextBlock Text="悬浮窗" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="背景不透明度" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="底板越透,桌面透出越多;压不住浅色桌面时往右调" Style="{StaticResource RowSub}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="OpacitySlider" Width="140" Minimum="30" Maximum="100"
                                                Style="{StaticResource LightSlider}" VerticalAlignment="Center"
                                                ValueChanged="SettingSlider_ValueChanged"/>
                                        <TextBlock x:Name="OpacityValue" Style="{StaticResource SliderValue}"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="在圆环下显示读数" Style="{StaticResource RowTitle}"/>
                                        <TextBlock x:Name="PercentHint" Text="" Style="{StaticResource RowSub}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ShowPercentBox" Grid.Column="1" Style="{StaticResource LightCheckBox}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Checked="Visibility_Changed" Unchecked="Visibility_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ 圆环与数字 ============ -->
                    <StackPanel x:Name="PageRings" Visibility="Collapsed">
                        <TextBlock Text="读数与报警" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="报警阈值" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="用量超过该比例时圆环转红" Style="{StaticResource RowSub}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="AlertSlider" Width="140" Minimum="50" Maximum="99"
                                                Style="{StaticResource LightSlider}" VerticalAlignment="Center"
                                                ValueChanged="SettingSlider_ValueChanged"/>
                                        <TextBlock x:Name="AlertValue" Style="{StaticResource SliderValue}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="圆环颜色" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowHint}" Margin="0,10,0,4"
                                           Text="颜色默认表示“离上限还有多远”(按用量着色),不是产品标识——产品由环心图标表示。想固定成品牌色就在这里选;额度用满时一律深红,不受这里影响。"/>
                                <Grid Margin="0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Command Code GOAT" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                    <local:TintPicker x:Name="GoatTintPick" Grid.Column="1" ValueChanged="Tint_ValueChanged"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Margin="0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="OpenCode Go" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                    <local:TintPicker x:Name="GoTintPick" Grid.Column="1" ValueChanged="Tint_ValueChanged"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Margin="0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DeepSeek" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                    <local:TintPicker x:Name="DeepSeekTintPick" Grid.Column="1" ValueChanged="Tint_ValueChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ 数据源 ============ -->
                    <StackPanel x:Name="PageSources" Visibility="Collapsed">
                        <TextBlock Text="凭据自动从环境变量 / CLI 登录态读取;也可以在下面手动输入 API Key(按当前 Windows 用户 DPAPI 加密保存)。"
                                   Style="{StaticResource RowHint}" Margin="1,0,0,12"/>

                        <!-- Command Code GOAT -->
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <DockPanel Margin="0,10">
                                    <CheckBox x:Name="ShowGoatBox" DockPanel.Dock="Right" Style="{StaticResource LightCheckBox}"
                                              Content="显示" HorizontalAlignment="Right"
                                              Checked="Visibility_Changed" Unchecked="Visibility_Changed"/>
                                    <StackPanel>
                                        <TextBlock Text="Command Code GOAT" FontSize="14" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                                        <TextBlock x:Name="GoatSource" FontSize="11" Foreground="#86868B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="GoatStatus" FontSize="12" Foreground="#86868B" TextWrapping="Wrap"/>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="GoatKey" Height="30" VerticalContentAlignment="Center"
                                             Style="{StaticResource LightTextBox}"/>
                                    <Button Grid.Column="1" Content="保存" Width="60" Height="30" Margin="8,0,0,0"
                                            Style="{StaticResource PrimaryButton}" Click="SaveGoat_Click"/>
                                </Grid>
                                <TextBlock x:Name="GoatHint" Style="{StaticResource RowHint}" Margin="0,7,0,10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- OpenCode Go -->
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <DockPanel Margin="0,10">
                                    <CheckBox x:Name="ShowGoBox" DockPanel.Dock="Right" Style="{StaticResource LightCheckBox}"
                                              Content="显示" HorizontalAlignment="Right"
                                              Checked="Visibility_Changed" Unchecked="Visibility_Changed"/>
                                    <StackPanel>
                                        <TextBlock Text="OpenCode Go" FontSize="14" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                                        <TextBlock x:Name="GoSource" FontSize="11" Foreground="#86868B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="GoStatus" FontSize="12" Foreground="#86868B" TextWrapping="Wrap"/>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="GoKey" Height="30" VerticalContentAlignment="Center"
                                             Style="{StaticResource LightTextBox}"/>
                                    <Button Grid.Column="1" Content="保存" Width="60" Height="30" Margin="8,0,0,0"
                                            Style="{StaticResource PrimaryButton}" Click="SaveGo_Click"/>
                                </Grid>
                                <TextBlock x:Name="GoHint" Style="{StaticResource RowHint}" Margin="0,7,0,10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- DeepSeek -->
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <DockPanel Margin="0,10">
                                    <CheckBox x:Name="ShowDeepSeekBox" DockPanel.Dock="Right" Style="{StaticResource LightCheckBox}"
                                              Content="显示" HorizontalAlignment="Right"
                                              Checked="Visibility_Changed" Unchecked="Visibility_Changed"/>
                                    <StackPanel>
                                        <TextBlock Text="DeepSeek" FontSize="14" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                                        <TextBlock x:Name="DeepSeekSource" FontSize="11" Foreground="#86868B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="DeepSeekStatus" FontSize="12" Foreground="#86868B" TextWrapping="Wrap"/>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DeepSeekKey" Height="30" VerticalContentAlignment="Center"
                                             Style="{StaticResource LightTextBox}"/>
                                    <Button Grid.Column="1" Content="保存" Width="60" Height="30" Margin="8,0,0,0"
                                            Style="{StaticResource PrimaryButton}" Click="SaveDeepSeek_Click"/>
                                </Grid>
                                <TextBlock x:Name="DeepSeekHint" Style="{StaticResource RowHint}" Margin="0,7,0,0" TextWrapping="Wrap"/>

                                <Border Style="{StaticResource RowSeparator}"/>
                                <!-- DeepSeek 只报余额、不报任何额度,所以环的百分比要自己定基准 -->
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="环的基准" Style="{StaticResource RowTitle}"/>
                                        <TextBlock x:Name="BasisHint" Text="" Style="{StaticResource RowSub}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="BasisCombo" Width="150" Height="30" Grid.Column="1"
                                              Style="{StaticResource LightCombo}" VerticalAlignment="Center"
                                              SelectionChanged="BasisCombo_SelectionChanged">
                                        <ComboBoxItem Content="自上次充值"/>
                                        <ComboBoxItem Content="只看余额"/>
                                        <ComboBoxItem Content="我的预算"/>
                                    </ComboBox>
                                </Grid>
                                <Grid x:Name="BudgetRow" Margin="0,0,0,10" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="预算金额" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="你认为的“满箱”是多少" Style="{StaticResource RowSub}"/>
                                    </StackPanel>
                                    <TextBox x:Name="BudgetBox" Grid.Column="1" Width="150" Height="30"
                                             VerticalContentAlignment="Center" Style="{StaticResource LightTextBox}"
                                             LostFocus="BudgetBox_LostFocus"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="SourceHint" FontSize="11" Foreground="#C7502E"
                                   Margin="1,0,0,10" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- ============ 刷新 ============ -->
                    <StackPanel x:Name="PageRefresh" Visibility="Collapsed">
                        <TextBlock Text="同步" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="同步间隔" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="成功获取数据后等待多久再拉一次" Style="{StaticResource RowSub}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="IntervalSlider" Width="140" Minimum="15" Maximum="300"
                                                Style="{StaticResource LightSlider}" VerticalAlignment="Center"
                                                ValueChanged="SettingSlider_ValueChanged"/>
                                        <TextBlock x:Name="IntervalValue" Style="{StaticResource SliderValue}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="数据" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel Margin="0,11">
                                <TextBlock Text="数据目录(便携)" Style="{StaticResource RowTitle}"/>
                                <TextBlock x:Name="DataDirText" Style="{StaticResource RowSub}" Margin="0,3,0,10"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
