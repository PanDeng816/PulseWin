<Window x:Class="PulseWin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PulseWin"
        Title="Pulse 设置" Width="470" Height="620" MinWidth="410" MinHeight="280"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#1C1C22" Foreground="#F5F5F7">

    <Window.Resources>
        <!-- 默认的 ComboBox 在暗色主题下是"白底下拉 + 浅色字",根本看不清。
             这里给它一套深色模板(ToggleButton 显示当前项,Popup 放下拉列表)。 -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="#26262E" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A44"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4A56"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#141419" BorderBrush="#3A3A44"
                                                BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"
                                                                  TextElement.Foreground="#F5F5F7"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Path Grid.Column="1" Data="M0,0 L4.5,5 L9,0" Stroke="#8CF5F5F7"
                                                      StrokeThickness="1.4" VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True">
                                <Border Background="#26262E" BorderBrush="#3A3A44" BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <StackPanel Margin="20">
            <TextBlock Text="数据来源" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="凭据自动从环境变量 / CLI 登录态读取;也可以在下面手动输入 API Key(按当前 Windows 用户 DPAPI 加密保存)。" TextWrapping="Wrap" Foreground="#8CF5F5F7" Margin="0,0,0,14"/>

            <!-- Command Code GOAT -->
            <Border Background="#26262E" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Command Code GOAT" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="GoatSource" FontSize="12" Foreground="#8CF5F5F7" Margin="10,2,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="GoatStatus" FontSize="12" Foreground="#8CF5F5F7" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GoatKey" Height="28" VerticalContentAlignment="Center" Background="#141419" Foreground="#F5F5F7" BorderBrush="#3A3A44"/>
                        <Button Grid.Column="1" Content="保存" Width="56" Height="28" Margin="8,0,0,0" Click="SaveGoat_Click"/>
                    </Grid>
                    <TextBlock x:Name="GoatHint" FontSize="11" Foreground="#8CF5F5F7" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- OpenCode Go -->
            <Border Background="#26262E" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="OpenCode Go" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="GoSource" FontSize="12" Foreground="#8CF5F5F7" Margin="10,2,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="GoStatus" FontSize="12" Foreground="#8CF5F5F7" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GoKey" Height="28" VerticalContentAlignment="Center" Background="#141419" Foreground="#F5F5F7" BorderBrush="#3A3A44"/>
                        <Button Grid.Column="1" Content="保存" Width="56" Height="28" Margin="8,0,0,0" Click="SaveGo_Click"/>
                    </Grid>
                    <TextBlock x:Name="GoHint" FontSize="11" Foreground="#8CF5F5F7" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- DeepSeek -->
            <Border Background="#26262E" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="DeepSeek" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DeepSeekSource" FontSize="12" Foreground="#8CF5F5F7" Margin="10,2,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="DeepSeekStatus" FontSize="12" Foreground="#8CF5F5F7" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DeepSeekKey" Height="28" VerticalContentAlignment="Center" Background="#141419" Foreground="#F5F5F7" BorderBrush="#3A3A44"/>
                        <Button Grid.Column="1" Content="保存" Width="56" Height="28" Margin="8,0,0,0" Click="SaveDeepSeek_Click"/>
                    </Grid>
                    <TextBlock x:Name="DeepSeekHint" FontSize="11" Foreground="#8CF5F5F7" Margin="0,6,0,0" TextWrapping="Wrap"/>

                    <!-- DeepSeek 只报余额、不报任何额度,所以环的百分比要自己定基准 -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="环的基准" FontSize="13" VerticalAlignment="Center"/>
                        <ComboBox x:Name="BasisCombo" Width="150" Height="26" Margin="10,0,0,0"
                                  Style="{StaticResource DarkCombo}"
                                  SelectionChanged="BasisCombo_SelectionChanged">
                            <ComboBoxItem Content="自上次充值"/>
                            <ComboBoxItem Content="只看余额"/>
                            <ComboBoxItem Content="我的预算"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="BasisHint" FontSize="11" Foreground="#8CF5F5F7" Margin="0,6,0,0" TextWrapping="Wrap"/>

                    <Grid x:Name="BudgetRow" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="预算金额" FontSize="13"/>
                            <TextBlock Text="你认为的“满箱”是多少" FontSize="11" Foreground="#8CF5F5F7"/>
                        </StackPanel>
                        <TextBox x:Name="BudgetBox" Grid.Column="1" Width="150" Height="26"
                                 VerticalContentAlignment="Center" Background="#141419" Foreground="#F5F5F7"
                                 BorderBrush="#3A3A44" LostFocus="BudgetBox_LostFocus"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 主界面 -->
            <TextBlock Text="主界面" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,10"/>
            <Border Background="#26262E" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="显示哪几个圆环" FontSize="13"/>
                    <TextBlock Text="关掉的源既不显示也不占高度。圆环尺寸固定,多一个源 rail 就长一截。"
                               FontSize="11" Foreground="#8CF5F5F7" Margin="0,2,0,8" TextWrapping="Wrap"/>
                    <CheckBox x:Name="ShowGoatBox" Content="Command Code GOAT" Foreground="#F5F5F7"
                              Margin="0,0,0,6" Checked="Visibility_Changed" Unchecked="Visibility_Changed"/>
                    <CheckBox x:Name="ShowGoBox" Content="OpenCode Go" Foreground="#F5F5F7"
                              Margin="0,0,0,6" Checked="Visibility_Changed" Unchecked="Visibility_Changed"/>
                    <CheckBox x:Name="ShowDeepSeekBox" Content="DeepSeek" Foreground="#F5F5F7"
                              Margin="0,0,0,14" Checked="Visibility_Changed" Unchecked="Visibility_Changed"/>

                    <CheckBox x:Name="ShowPercentBox" Content="在圆环下显示读数(百分比 / 余额)" Foreground="#F5F5F7"
                              Checked="Visibility_Changed" Unchecked="Visibility_Changed"/>
                    <TextBlock x:Name="PercentHint" FontSize="11" Foreground="#8CF5F5F7"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 每个源一个自定义颜色 -->
            <TextBlock Text="圆环颜色" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,10"/>
            <Border Background="#26262E" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="点右侧色块选固定颜色;选「自动」= 按用量着色(绿 → 红)。环的颜色默认表示“离上限还有多远”,不是产品标识(产品由环心图标表示)。额度用满时一律深红,不受这里影响。"
                               FontSize="11" Foreground="#8CF5F5F7" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Command Code GOAT" FontSize="13" VerticalAlignment="Center"/>
                        <local:TintPicker x:Name="GoatTintPick" Grid.Column="1" ValueChanged="Tint_ValueChanged"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OpenCode Go" FontSize="13" VerticalAlignment="Center"/>
                        <local:TintPicker x:Name="GoTintPick" Grid.Column="1" ValueChanged="Tint_ValueChanged"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DeepSeek" FontSize="13" VerticalAlignment="Center"/>
                        <local:TintPicker x:Name="DeepSeekTintPick" Grid.Column="1" ValueChanged="Tint_ValueChanged"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 显示与刷新 -->
            <TextBlock Text="显示与刷新" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,10"/>
            <Border Background="#26262E" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="报警阈值" FontSize="13"/>
                            <TextBlock Text="用量超过该比例时圆环转红" FontSize="11" Foreground="#8CF5F5F7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Slider x:Name="AlertSlider" Width="120" Minimum="50" Maximum="99"
                                    VerticalAlignment="Center" ValueChanged="SettingSlider_ValueChanged"/>
                            <TextBlock x:Name="AlertValue" Width="42" TextAlignment="Right"
                                       VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="背景不透明度" FontSize="13"/>
                            <TextBlock Text="rail 底板的透明程度" FontSize="11" Foreground="#8CF5F5F7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Slider x:Name="OpacitySlider" Width="120" Minimum="30" Maximum="100"
                                    VerticalAlignment="Center" ValueChanged="SettingSlider_ValueChanged"/>
                            <TextBlock x:Name="OpacityValue" Width="42" TextAlignment="Right"
                                       VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="同步间隔" FontSize="13"/>
                            <TextBlock Text="成功获取数据后等待多久再拉一次" FontSize="11" Foreground="#8CF5F5F7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Slider x:Name="IntervalSlider" Width="120" Minimum="15" Maximum="300"
                                    VerticalAlignment="Center" ValueChanged="SettingSlider_ValueChanged"/>
                            <TextBlock x:Name="IntervalValue" Width="42" TextAlignment="Right"
                                       VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="DataDirText" FontSize="11" Foreground="#59F5F5F7" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <Button Content="关闭" Width="72" Height="26" HorizontalAlignment="Right" Click="Close_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
