<Window x:Class="PulseWin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PulseWin"
        Title="PulseWin 设置" Width="860" Height="600" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#F5F5F7" Foreground="#1D1D1F"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">

    <!-- 亮色主题,对齐上游设置窗:左侧分页导航 + 右侧内容,行 = 左标题副标题/右控件,
         分组白卡 + hairline。控件样式来自 Themes/Light.xaml。 -->

    <Window.Resources>
        <!-- 侧栏导航项:选中蓝底白字,hover 浅灰。图标用系统 Segoe MDL2。 -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="11,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="icon" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Margin="0,1,10,0"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#6E6E73"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E9E9EC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#007AFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="icon" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧栏分组小标签 -->
        <Style x:Key="NavGroup" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="Margin" Value="12,16,0,5"/>
        </Style>

        <!-- 页内分节标题 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="Margin" Value="1,0,0,8"/>
        </Style>

        <!-- 分组白卡 -->
        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3E3E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,4"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- 行:左标题+副标题,右控件 -->
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
        </Style>
        <Style x:Key="RowSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#86868B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#86868B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RowSeparator" TargetType="Border">
            <Setter Property="Background" Value="#E8E8EC"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="-16,10"/>
        </Style>

        <!-- 三档分段选择(尺寸/间距):浅灰轨道、选中蓝块白字,上游 Size/Spacing 同款 -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#EBEBEF" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E0E4"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#007AFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滑杆行右侧的值标签 -->
        <Style x:Key="SliderValue" TargetType="TextBlock">
            <Setter Property="Width" Value="44"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ————— 侧栏 ————— -->
        <Border Grid.Column="0" Background="#F5F5F7" BorderBrush="#E3E3E6" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,14,12,14">
                    <TextBlock Text="面板" Style="{StaticResource NavGroup}" Margin="12,2,0,5"/>
                    <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" Tag="&#xE790;"
                                 GroupName="nav" IsChecked="True" Content="外观" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavBehavior" Style="{StaticResource NavItem}" Tag="&#xE7A7;"
                                 GroupName="nav" Content="行为" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavRings" Style="{StaticResource NavItem}" Tag="&#xE9D9;"
                                 GroupName="nav" Content="圆环与数字" Checked="Nav_Checked"/>
                    <TextBlock Text="数据" Style="{StaticResource NavGroup}"/>
                    <RadioButton x:Name="NavSources" Style="{StaticResource NavItem}" Tag="&#xE772;"
                                 GroupName="nav" Content="数据源" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavModels" Style="{StaticResource NavItem}" Tag="&#xE9D2;"
                                 GroupName="nav" Content="套餐用量" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavRefresh" Style="{StaticResource NavItem}" Tag="&#xE777;"
                                 GroupName="nav" Content="刷新与网络" Checked="Nav_Checked"/>
                    <TextBlock Text="应用" Style="{StaticResource NavGroup}"/>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="&#xE946;"
                                 GroupName="nav" Content="关于" Checked="Nav_Checked"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ————— 内容区 ————— -->
        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitle" Text="外观" FontSize="22" FontWeight="Bold"
                       Foreground="#1D1D1F" Margin="34,24,34,14"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <StackPanel Margin="34,0,34,26" TextElement.FontFamily="Segoe UI, Microsoft YaHei UI">

                    <!-- ============ 外观 ============ -->
                    <StackPanel x:Name="PageAppearance">
                        <TextBlock Text="悬浮窗" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="圆环大小" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="默认档比旧版小一圈、细一号" Style="{StaticResource RowSub}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="SizeSmall" Style="{StaticResource Segment}" Content="小" GroupName="ringsize" Checked="RingSize_Changed"/>
                                        <RadioButton x:Name="SizeStandard" Style="{StaticResource Segment}" Content="标准" GroupName="ringsize" IsChecked="True" Checked="RingSize_Changed"/>
                                        <RadioButton x:Name="SizeLarge" Style="{StaticResource Segment}" Content="大" GroupName="ringsize" Checked="RingSize_Changed"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="圆环间距" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="环与环之间留多少空隙" Style="{StaticResource RowSub}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="SpacingTight" Style="{StaticResource Segment}" Content="紧" GroupName="ringspacing" Checked="RingSpacing_Changed"/>
                                        <RadioButton x:Name="SpacingStandard" Style="{StaticResource Segment}" Content="标准" GroupName="ringspacing" IsChecked="True" Checked="RingSpacing_Changed"/>
                                        <RadioButton x:Name="SpacingLoose" Style="{StaticResource Segment}" Content="松" GroupName="ringspacing" Checked="RingSpacing_Changed"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="背景不透明度" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="底板越透,桌面透出越多;压不住浅色桌面时往右调" Style="{StaticResource RowSub}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="OpacitySlider" Width="140" Minimum="30" Maximum="100"
                                                Style="{StaticResource LightSlider}" VerticalAlignment="Center"
                                                ValueChanged="SettingSlider_ValueChanged"/>
                                        <TextBlock x:Name="OpacityValue" Style="{StaticResource SliderValue}"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="在圆环下显示读数" Style="{StaticResource RowTitle}"/>
                                        <TextBlock x:Name="PercentHint" Text="" Style="{StaticResource RowSub}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ShowPercentBox" Grid.Column="1" Style="{StaticResource LightCheckBox}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Checked="ShowPercent_Changed" Unchecked="ShowPercent_Changed"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="只在有用量时显示 5 小时圈" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="关掉内圈的源只画总额度外环。5 小时窗口没用过的源不画内圈——内圈出现就表示这个源正在被用" Style="{StaticResource RowSub}" MaxWidth="430" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <CheckBox x:Name="IdleInnerRingBox" Grid.Column="1" Style="{StaticResource LightCheckBox}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Checked="IdleInnerRing_Changed" Unchecked="IdleInnerRing_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ 行为 ============ -->
                    <StackPanel x:Name="PageBehavior" Visibility="Collapsed">
                        <TextBlock Text="自动隐藏" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="隐藏时收成贴边小条" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="不用时折叠成贴在屏幕边缘的细条,有源越过警报阈值时细条会变色;指针靠近即展开。关掉则完全滑出屏幕外" Style="{StaticResource RowSub}" MaxWidth="430" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <CheckBox x:Name="SliverBox" Grid.Column="1" Style="{StaticResource LightCheckBox}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Checked="Sliver_Changed" Unchecked="Sliver_Changed"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="全屏时隐藏" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="前台是全屏应用(视频/游戏/演示)时自动收起,期间指针到屏边也不会弹出;退出全屏后指针到屏边唤回" Style="{StaticResource RowSub}" MaxWidth="430" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <CheckBox x:Name="FullScreenBox" Grid.Column="1" Style="{StaticResource LightCheckBox}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Checked="FullScreen_Changed" Unchecked="FullScreen_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="圆环顺序" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel Margin="0,11">
                                <TextBlock Text="rail 上数据源的排列" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="拖动行首的手柄,或点右侧箭头逐格移动;从上到下就是 rail 上的顺序。只列已显示的圆环——要增减显示哪些源,去「数据源」页勾选。"
                                           Style="{StaticResource RowSub}" Margin="0,3,0,8"/>
                                <!-- 可重排列表:源一多时不会像"排列组合下拉框"那样爆炸 -->
                                <local:RingOrderList x:Name="RingOrder"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ 圆环与数字 ============ -->
                    <StackPanel x:Name="PageRings" Visibility="Collapsed">
                        <TextBlock Text="读数与报警" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="报警阈值" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="用量超过该比例时圆环转红" Style="{StaticResource RowSub}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="AlertSlider" Width="140" Minimum="50" Maximum="99"
                                                Style="{StaticResource LightSlider}" VerticalAlignment="Center"
                                                ValueChanged="SettingSlider_ValueChanged"/>
                                        <TextBlock x:Name="AlertValue" Style="{StaticResource SliderValue}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="圆环颜色" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowHint}" Margin="0,10,0,4"
                                           Text="颜色默认表示“离上限还有多远”(按用量着色),不是产品标识——产品由环心图标表示。想固定成品牌色就在这里选;额度用满时一律深红,不受这里影响。"/>
                                <!-- 每个源一行,按 SourceCatalog 生成(见 BuildTintPickers) -->
                                <StackPanel x:Name="TintPanel"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ 数据源 ============ -->
                    <!-- 每张凭据卡按 SourceCatalog 生成(见 SourceCard.cs):加一个源只改注册表,
                         不用在这里复制一整块 XAML、再去代码里同步命名控件。 -->
                    <StackPanel x:Name="PageSources" Visibility="Collapsed">
                        <TextBlock Text="凭据自动从环境变量 / CLI 登录态读取;也可以在下面手动输入 API Key(按当前 Windows 用户 DPAPI 加密保存)。"
                                   Style="{StaticResource RowHint}" Margin="1,0,0,12"/>
                        <StackPanel x:Name="SourceCardsPanel"/>
                        <TextBlock x:Name="SourceHint" FontSize="11" Foreground="#C7502E"
                                   Margin="1,0,0,10" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- ============ 套餐用量 ============ -->
                    <StackPanel x:Name="PageModels" Visibility="Collapsed">
                        <TextBlock x:Name="ModelsIntro" Style="{StaticResource RowHint}" Margin="1,0,0,12"
                                   Text="按套餐/渠道看用量。数据来自各客户端自己的记录库(ZCode / OpenCode),按 models.dev 公开 API 价估算金额——不是账单。上面切换套餐,下面看该套餐的详细数据。"/>

                        <!-- 区间切换 -->
                        <Grid Margin="1,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ModelSpanToday" Style="{StaticResource Segment}" Content="今天" GroupName="modelspan" Checked="ModelSpan_Checked"/>
                                <RadioButton x:Name="ModelSpanWeek" Style="{StaticResource Segment}" Content="7 天" GroupName="modelspan" IsChecked="True" Checked="ModelSpan_Checked"/>
                                <RadioButton x:Name="ModelSpanMonth" Style="{StaticResource Segment}" Content="30 天" GroupName="modelspan" Checked="ModelSpan_Checked"/>
                                <RadioButton x:Name="ModelSpanAll" Style="{StaticResource Segment}" Content="全部" GroupName="modelspan" Checked="ModelSpan_Checked"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="ModelsStatus" Style="{StaticResource RowHint}" Margin="1,0,0,10" TextWrapping="Wrap"/>

                        <!-- 套餐切换(每个套餐一个按钮,选中即下面显示它的数据) -->
                        <Border Style="{StaticResource GroupCard}" Padding="12,10">
                            <!-- 套餐切换按钮用 WrapPanel:套餐可能有好几个(含未启用/无用量
                                 的),横向 StackPanel 不换行会被右缘截断 -->
                            <WrapPanel x:Name="ChannelTabsPanel" Orientation="Horizontal"/>
                        </Border>

                        <!-- 选中套餐的详细信息 -->
                        <StackPanel x:Name="ChannelDetailPanel" Visibility="Collapsed">
                            <!-- KPI 六格:总费用 / 总请求 / 总 TOKEN / 缓存命中率 / 缓存读+写 / 会话数 -->
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel Margin="0,12">
                                    <TextBlock x:Name="ChannelTitle" Style="{StaticResource RowTitle}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ChannelSubtitle" Style="{StaticResource RowSub}" Margin="0,3,0,0"/>
                                    <UniformGrid x:Name="ChannelKpiGrid" Columns="3" Margin="0,12,0,2"/>
                                    <Border Style="{StaticResource RowSeparator}"/>
                                    <!-- Token 六格构成(输入/输出/缓存读/缓存写/未分类/合计) -->
                                    <TextBlock Text="Token 构成" Style="{StaticResource RowTitle}" Margin="0,10,0,0"/>
                                    <UniformGrid x:Name="ChannelTokenGrid" Columns="3" Margin="0,8,0,2"/>
                                </StackPanel>
                            </Border>

                            <!-- 今日 24 小时 -->
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel Margin="0,12">
                                    <TextBlock Text="今日逐小时" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="ChannelTodayHint" Style="{StaticResource RowSub}" Margin="0,3,0,8"/>
                                    <Border x:Name="ChannelHourBox" Height="110" Background="Transparent"/>
                                </StackPanel>
                            </Border>

                            <!-- 性能与行为(来自客户端记录的遥测:推理/耗时/首字/工具/重试) -->
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel Margin="0,12">
                                    <TextBlock Text="性能与行为" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="ChannelPerfHint" Style="{StaticResource RowSub}" Margin="0,3,0,8"/>
                                    <UniformGrid x:Name="ChannelPerfGrid" Columns="3" Margin="0,2,0,2"/>
                                </StackPanel>
                            </Border>

                            <!-- 每日趋势 -->
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel Margin="0,12">
                                    <TextBlock Text="每日用量" Style="{StaticResource RowTitle}"/>
                                    <Border x:Name="ChannelDailyBox" Height="110" Background="Transparent" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 模型分布 -->
                            <Border Style="{StaticResource GroupCard}" Padding="0">
                                <StackPanel>
                                    <TextBlock Text="这个套餐里各模型的用量" Style="{StaticResource RowTitle}" Margin="16,14,16,4"/>
                                    <StackPanel x:Name="ChannelModelPanel"/>
                                </StackPanel>
                            </Border>

                            <!-- 逐日明细(模型 × 天 的矩阵) -->
                            <Border Style="{StaticResource GroupCard}" Padding="0">
                                <StackPanel>
                                    <TextBlock Text="逐日明细" Style="{StaticResource RowTitle}" Margin="16,14,16,4"/>
                                    <TextBlock x:Name="ChannelDailyTableHint" Style="{StaticResource RowSub}" Margin="16,0,16,6"/>
                                    <StackPanel x:Name="ChannelDailyTablePanel"/>
                                </StackPanel>
                            </Border>

                            <!-- 归属信息(provider id / 时间范围 / 用量仓库说明) -->
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel Margin="0,12">
                                    <TextBlock Text="归属信息" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="ChannelMetaLine" Style="{StaticResource RowHint}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 可选:Command Code 浏览器会话明细(默认关,有 AV 误判风险) -->
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="浏览器会话明细(交叉核对,不影响数字)" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Style="{StaticResource RowSub}" MaxWidth="440" HorizontalAlignment="Left"
                                                   Text="读本机浏览器(Edge/Chrome)的登录 cookie,抓 Command Code 只有登录态才开放的逐模型缓存明细,与本机库的记录做交叉核对。注意:本机库本来就覆盖了同样的用量,所以打开它不会让统计数字更准——它只是多一层旁证。默认关:读 cookie 可能被安全软件误判(同类工具曾被 AV 当作 infostealer);且浏览器运行时其 cookie 库是排他锁定的,通常要完全退出浏览器才读得到。"/>
                                    </StackPanel>
                                    <CheckBox x:Name="BrowserSessionBox" Grid.Column="1" Style="{StaticResource LightCheckBox}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Checked="BrowserSession_Changed" Unchecked="BrowserSession_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ 刷新 ============ -->
                    <StackPanel x:Name="PageRefresh" Visibility="Collapsed">
                        <TextBlock Text="同步" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="同步间隔" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="成功获取数据后等待多久再拉一次" Style="{StaticResource RowSub}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="IntervalSlider" Width="140" Minimum="15" Maximum="300"
                                                Style="{StaticResource LightSlider}" VerticalAlignment="Center"
                                                ValueChanged="SettingSlider_ValueChanged"/>
                                        <TextBlock x:Name="IntervalValue" Style="{StaticResource SliderValue}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="网络" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="网络代理" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="数据源 API、价目表更新与检查更新都走这里。改完重启程序生效" Style="{StaticResource RowSub}" MaxWidth="430" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ProxyCombo" Width="150" Height="30" Grid.Column="1"
                                              Style="{StaticResource LightCombo}" VerticalAlignment="Center"
                                              SelectionChanged="ProxyCombo_SelectionChanged">
                                        <ComboBoxItem Content="跟随系统"/>
                                        <ComboBoxItem Content="直连"/>
                                        <ComboBoxItem Content="手动代理"/>
                                    </ComboBox>
                                </Grid>
                                <Grid x:Name="ProxyRow" Margin="0,0,0,11" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="代理地址" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="HTTP 代理;Clash/V2Ray 等填它们的 HTTP 端口" Style="{StaticResource RowSub}"/>
                                    </StackPanel>
                                    <TextBox x:Name="ProxyBox" Grid.Column="1" Width="200" Height="30"
                                             VerticalContentAlignment="Center" Style="{StaticResource LightTextBox}"
                                             LostFocus="ProxyBox_LostFocus"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="数据" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="美元兑人民币汇率" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="用量统计的估算金额按此换算显示;价目表本身是美元。填 0 显示美元原值。" Style="{StaticResource RowSub}" MaxWidth="430" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <TextBox x:Name="UsdRateBox" Grid.Column="1" Width="90" Height="30"
                                             VerticalContentAlignment="Center" Style="{StaticResource LightTextBox}"
                                             LostFocus="UsdRateBox_LostFocus"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <StackPanel Margin="0,11">
                                    <TextBlock Text="数据目录(便携)" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="DataDirText" Style="{StaticResource RowSub}" Margin="0,3,0,10"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ 关于 ============ -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <TextBlock Text="应用" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel Margin="0,11">
                                <TextBlock Text="PulseWin" Style="{StaticResource RowTitle}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AboutVersion" Style="{StaticResource RowSub}" Margin="0,3,0,0"/>
                                <TextBlock Style="{StaticResource RowSub}" Margin="0,6,0,0"
                                           Text="Windows 版用量悬浮轨,展示层移植自 macOS 应用 Pulse(qunqin24/Pulse),数据层来自 Command Code GOAT Usage Monitor。统计金额按 models.dev 公开价估算,不是账单。"/>
                                <Button x:Name="CheckUpdateButton" Content="检查更新" Width="96" Height="30"
                                        Style="{StaticResource LightButton}" HorizontalAlignment="Left" Margin="0,10,0,10"
                                        Click="CheckUpdate_Click"/>
                                <TextBlock x:Name="UpdateHint" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
