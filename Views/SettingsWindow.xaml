<Window x:Class="PulseWin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PulseWin"
        Title="PulseWin 设置" Width="860" Height="600" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#F5F5F7" Foreground="#1D1D1F"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">

    <!-- 亮色主题,对齐上游设置窗:左侧分页导航 + 右侧内容,行 = 左标题副标题/右控件,
         分组白卡 + hairline。控件样式来自 Themes/Light.xaml。 -->

    <Window.Resources>
        <!-- 侧栏导航项:选中蓝底白字,hover 浅灰。图标用系统 Segoe MDL2。 -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="11,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="icon" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Margin="0,1,10,0"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#6E6E73"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E9E9EC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#007AFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="icon" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧栏分组小标签 -->
        <Style x:Key="NavGroup" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="Margin" Value="12,16,0,5"/>
        </Style>

        <!-- 页内分节标题 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="Margin" Value="1,0,0,8"/>
        </Style>

        <!-- 分组白卡 -->
        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3E3E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,4"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- 行:左标题+副标题,右控件 -->
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
        </Style>
        <Style x:Key="RowSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#86868B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#86868B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RowSeparator" TargetType="Border">
            <Setter Property="Background" Value="#E8E8EC"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="-16,10"/>
        </Style>

        <!-- 三档分段选择(尺寸/间距):浅灰轨道、选中蓝块白字,上游 Size/Spacing 同款 -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#EBEBEF" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E0E4"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#007AFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滑杆行右侧的值标签 -->
        <Style x:Key="SliderValue" TargetType="TextBlock">
            <Setter Property="Width" Value="44"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ————— 侧栏 ————— -->
        <Border Grid.Column="0" Background="#F5F5F7" BorderBrush="#E3E3E6" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,14,12,14">
                    <TextBlock Text="面板" Style="{StaticResource NavGroup}" Margin="12,2,0,5"/>
                    <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" Tag="&#xE790;"
                                 GroupName="nav" IsChecked="True" Content="外观" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavBehavior" Style="{StaticResource NavItem}" Tag="&#xE7A7;"
                                 GroupName="nav" Content="行为" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavRings" Style="{StaticResource NavItem}" Tag="&#xE9D9;"
                                 GroupName="nav" Content="圆环与数字" Checked="Nav_Checked"/>
                    <TextBlock Text="数据" Style="{StaticResource NavGroup}"/>
                    <RadioButton x:Name="NavSources" Style="{StaticResource NavItem}" Tag="&#xE772;"
                                 GroupName="nav" Content="数据源" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavRefresh" Style="{StaticResource NavItem}" Tag="&#xE777;"
                                 GroupName="nav" Content="刷新与网络" Checked="Nav_Checked"/>
                    <TextBlock Text="应用" Style="{StaticResource NavGroup}"/>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="&#xE946;"
                                 GroupName="nav" Content="关于" Checked="Nav_Checked"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ————— 内容区 ————— -->
        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitle" Text="外观" FontSize="22" FontWeight="Bold"
                       Foreground="#1D1D1F" Margin="34,24,34,14"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <StackPanel Margin="34,0,34,26" TextElement.FontFamily="Segoe UI, Microsoft YaHei UI">

                    <!-- ============ 外观 ============ -->
                    <StackPanel x:Name="PageAppearance">
                        <TextBlock Text="悬浮窗" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="圆环大小" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="SizeSmall" Style="{StaticResource Segment}" Content="小" GroupName="ringsize" Checked="RingSize_Changed"/>
                                        <RadioButton x:Name="SizeStandard" Style="{StaticResource Segment}" Content="标准" GroupName="ringsize" IsChecked="True" Checked="RingSize_Changed"/>
                                        <RadioButton x:Name="SizeLarge" Style="{StaticResource Segment}" Content="大" GroupName="ringsize" Checked="RingSize_Changed"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="圆环间距" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="SpacingTight" Style="{StaticResource Segment}" Content="紧" GroupName="ringspacing" Checked="RingSpacing_Changed"/>
                                        <RadioButton x:Name="SpacingStandard" Style="{StaticResource Segment}" Content="标准" GroupName="ringspacing" IsChecked="True" Checked="RingSpacing_Changed"/>
                                        <RadioButton x:Name="SpacingLoose" Style="{StaticResource Segment}" Content="松" GroupName="ringspacing" Checked="RingSpacing_Changed"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="背景不透明度" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="OpacitySlider" Width="140" Minimum="30" Maximum="100"
                                                Style="{StaticResource LightSlider}" VerticalAlignment="Center"
                                                ValueChanged="SettingSlider_ValueChanged"/>
                                        <TextBlock x:Name="OpacityValue" Style="{StaticResource SliderValue}"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="在圆环下显示读数" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ShowPercentBox" Grid.Column="1" Style="{StaticResource LightCheckBox}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Checked="ShowPercent_Changed" Unchecked="ShowPercent_Changed"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="只在正在使用时显示 5 小时圈" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="IdleInnerRingBox" Grid.Column="1" Style="{StaticResource LightCheckBox}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Checked="IdleInnerRing_Changed" Unchecked="IdleInnerRing_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ 行为 ============ -->
                    <StackPanel x:Name="PageBehavior" Visibility="Collapsed">
                        <TextBlock Text="自动隐藏" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="隐藏时收成贴边小条" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="SliverBox" Grid.Column="1" Style="{StaticResource LightCheckBox}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Checked="Sliver_Changed" Unchecked="Sliver_Changed"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="全屏时隐藏" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="FullScreenBox" Grid.Column="1" Style="{StaticResource LightCheckBox}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Checked="FullScreen_Changed" Unchecked="FullScreen_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="圆环顺序" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel Margin="0,11">
                                <!-- 可重排列表:源一多时不会像"排列组合下拉框"那样爆炸 -->
                                <local:RingOrderList x:Name="RingOrder"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ 圆环与数字 ============ -->
                    <StackPanel x:Name="PageRings" Visibility="Collapsed">
                        <TextBlock Text="读数与报警" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="报警阈值" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="AlertSlider" Width="140" Minimum="50" Maximum="99"
                                                Style="{StaticResource LightSlider}" VerticalAlignment="Center"
                                                ValueChanged="SettingSlider_ValueChanged"/>
                                        <TextBlock x:Name="AlertValue" Style="{StaticResource SliderValue}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="圆环颜色" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <!-- 每个源一行,按 SourceCatalog 生成(见 BuildTintPickers) -->
                                <StackPanel x:Name="TintPanel" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ 数据源 ============ -->
                    <!-- 每张凭据卡按 SourceCatalog 生成(见 SourceCard.cs):加一个源只改注册表,
                         不用在这里复制一整块 XAML、再去代码里同步命名控件。 -->
                    <StackPanel x:Name="PageSources" Visibility="Collapsed">
                        <StackPanel x:Name="SourceCardsPanel"/>
                        <TextBlock x:Name="SourceHint" FontSize="11" Foreground="#C7502E"
                                   Margin="1,0,0,10" TextWrapping="Wrap" Visibility="Collapsed"/>

                        <!-- 用量展示已整体搬到「用量」窗口(原"套餐用量"页),这里只留入口 -->
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="用量数据" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                    <Button x:Name="OpenUsageButton" Grid.Column="1" Style="{StaticResource LightButton}"
                                            Content="打开用量窗口…" Click="OpenUsage_Click"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- BigModel 没有配额接口:手填包月预算,用量窗额度条才有进度条 -->
                                <Grid Margin="0,4,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="BigModel 包月预算(元/月,选填)" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="BigModelBudgetBox" Grid.Column="1" Width="90" VerticalAlignment="Center"
                                             HorizontalContentAlignment="Right" TextChanged="BigModelBudget_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 可选:Command Code 浏览器会话明细(默认关,有 AV 误判风险) -->
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="浏览器会话明细(账号级)" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="BrowserSessionBox" Grid.Column="1" Style="{StaticResource LightCheckBox}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Checked="BrowserSession_Changed" Unchecked="BrowserSession_Changed"/>
                                </Grid>

                                <!-- 登录会话:两家各一行。读本机 Edge 的 cookie 库已被 v20
                                     (App-Bound Encryption)堵死,内嵌 WebView2 登录窗是唯一自动化的路。 -->
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="登录 commandcode.ai" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="CommandCodeLoginState" Style="{StaticResource RowSub}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button x:Name="CommandCodeLoginButton" Style="{StaticResource LightButton}" Content="登录…"
                                                Tag="commandcode" Padding="12,5" Click="Login_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="登录 opencode.ai" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="OpenCodeLoginState" Style="{StaticResource RowSub}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button x:Name="OpenCodeLoginButton" Style="{StaticResource LightButton}" Content="登录…"
                                                Tag="opencode" Padding="12,5" Click="Login_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 读不到时的兜底:手动粘贴会话 cookie(站点可选;GoGauge 也有这一手) -->
                                <StackPanel Margin="0,0,0,11">
                                    <TextBlock Text="手动粘贴会话 cookie(兜底)" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="ManualCookieHint" Style="{StaticResource RowSub}" MaxWidth="520" HorizontalAlignment="Left"
                                               Text=""/>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <ComboBox x:Name="ManualCookieSite" Width="170" VerticalAlignment="Center"
                                                  Style="{StaticResource LightCombo}"
                                                  SelectionChanged="ManualCookieSite_Changed"/>
                                        <TextBox x:Name="ManualCookieBox" Width="200" Margin="6,0,0,0" VerticalAlignment="Center"
                                                 Style="{StaticResource LightTextBox}"
                                                 ToolTip="粘贴 cookie 值,或整条 Cookie 串"/>
                                        <Button x:Name="ManualCookieSave" Style="{StaticResource LightButton}" Content="保存"
                                                Margin="6,0,0,0" Click="ManualCookieSave_Click"/>
                                        <Button x:Name="ManualCookieClear" Style="{StaticResource LightButton}" Content="清除"
                                                Margin="4,0,0,0" Click="ManualCookieClear_Click"/>
                                        <TextBlock x:Name="ManualCookieState" Style="{StaticResource RowSub}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ 刷新 ============ -->
                    <StackPanel x:Name="PageRefresh" Visibility="Collapsed">
                        <TextBlock Text="同步" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="同步间隔" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="IntervalSlider" Width="140" Minimum="15" Maximum="300"
                                                Style="{StaticResource LightSlider}" VerticalAlignment="Center"
                                                ValueChanged="SettingSlider_ValueChanged"/>
                                        <TextBlock x:Name="IntervalValue" Style="{StaticResource SliderValue}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="网络" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="网络代理" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="改完重启程序生效" Style="{StaticResource RowSub}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ProxyCombo" Width="150" Height="30" Grid.Column="1"
                                              Style="{StaticResource LightCombo}" VerticalAlignment="Center"
                                              SelectionChanged="ProxyCombo_SelectionChanged">
                                        <ComboBoxItem Content="跟随系统"/>
                                        <ComboBoxItem Content="直连"/>
                                        <ComboBoxItem Content="手动代理"/>
                                    </ComboBox>
                                </Grid>
                                <Grid x:Name="ProxyRow" Margin="0,0,0,11" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="代理地址" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ProxyBox" Grid.Column="1" Width="200" Height="30"
                                             VerticalContentAlignment="Center" Style="{StaticResource LightTextBox}"
                                             LostFocus="ProxyBox_LostFocus"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="数据" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="美元兑人民币汇率" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="UsdRateBox" Grid.Column="1" Width="90" Height="30"
                                             VerticalContentAlignment="Center" Style="{StaticResource LightTextBox}"
                                             LostFocus="UsdRateBox_LostFocus"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <StackPanel Margin="0,11">
                                    <TextBlock Text="数据目录(便携)" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="DataDirText" Style="{StaticResource RowSub}" Margin="0,3,0,10"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ 关于 ============ -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <TextBlock Text="应用" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel Margin="0,11">
                                <TextBlock Text="PulseWin" Style="{StaticResource RowTitle}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AboutVersion" Style="{StaticResource RowSub}" Margin="0,3,0,0"/>
                                <TextBlock Style="{StaticResource RowSub}" Margin="0,6,0,0"
                                           Text="金额按 models.dev 公开牌价估算,不是账单。"/>
                                <Button x:Name="CheckUpdateButton" Content="检查更新" Width="96" Height="30"
                                        Style="{StaticResource LightButton}" HorizontalAlignment="Left" Margin="0,10,0,10"
                                        Click="CheckUpdate_Click"/>
                                <TextBlock x:Name="UpdateHint" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
