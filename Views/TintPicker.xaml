<UserControl x:Class="PulseWin.TintPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderThickness="2" BorderBrush="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9A9AA2"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="selected">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#007AFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 宽度要装得下最长的文案“自动 · 按用量”(11pt 实测 63.4diu),
             加上色块 30 + 间距 6 + 左右留白 10 = 110;取 112 留一点余量。
             之前 96 时右边被切掉,显示成“自动 · 按”。 -->
        <ToggleButton x:Name="SwatchButton" Click="Swatch_Click" Width="112" Height="26" Cursor="Hand"
                      Focusable="False">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="White" BorderBrush="#D8D8DC" BorderThickness="1"
                            CornerRadius="5">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#B9B9BF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#007AFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <!-- 色块与文字放 Content 里(名字在窗口名字域内,代码可直接引用) -->
            <Grid Margin="5,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="SwatchFill" Width="30" Height="16" CornerRadius="3"
                        BorderBrush="#E3E3E6" BorderThickness="1"/>
                <TextBlock x:Name="SwatchText" Grid.Column="1" Margin="6,0,0,0" FontSize="11"
                           VerticalAlignment="Center" Foreground="#1D1D1F"/>
            </Grid>
        </ToggleButton>

        <!-- 色板弹层:与设置窗白卡同风格,点色即生效并关闭 -->
        <Popup x:Name="PalettePopup" AllowsTransparency="True" StaysOpen="False"
               Placement="Bottom" PlacementTarget="{Binding ElementName=SwatchButton}"
               VerticalOffset="4">
            <Border Background="White" BorderBrush="#E0E0E4" BorderThickness="1" CornerRadius="10"
                    Padding="12" Margin="10" Width="236">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="固定环色" FontSize="12" Foreground="#1D1D1F" Margin="2,0,0,8"/>
                    <UniformGrid x:Name="Palette" Columns="5" Rows="4"/>
                    <Button Content="按用量着色(自动)" Click="Auto_Click" Height="27" Margin="0,10,0,0"
                            FontSize="12" Style="{StaticResource LightButton}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HexBox" Height="27" VerticalContentAlignment="Center" FontSize="12"
                                 Style="{StaticResource LightTextBox}"
                                 KeyDown="Hex_KeyDown" LostFocus="Hex_LostFocus"/>
                        <Button Grid.Column="1" Content="填入" Width="46" Height="27" Margin="6,0,0,0"
                                Click="HexApply_Click" FontSize="12" Style="{StaticResource LightButton}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
