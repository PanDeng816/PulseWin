<Window x:Class="PulseWin.SpendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulse 用量统计" Width="580" Height="760" MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#1C1C22" Foreground="#F5F5F7">

    <Window.Resources>
        <!-- 与设置窗口同一套暗色按钮:默认 WPF 按钮在深底上发白,很刺眼 -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#2C2C36" BorderBrush="#3A3A44"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 区间选择:选中的那颗用亮底,一眼看出当前看的是哪段 -->
        <Style x:Key="SpanToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B0F5F5F7"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#22222A" BorderBrush="#3A3A44"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33333E"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4A58"/>
                                <Setter Property="Foreground" Value="#F5F5F7"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#26262E"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>

        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8CF5F5F7"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 列表行:名称 / 数字 / 金额 / 比例条 -->
        <DataTemplate x:Key="RowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Border Background="#1A1A20" CornerRadius="2" Height="4" Width="180" HorizontalAlignment="Left">
                            <Border Background="{Binding BarBrush}" CornerRadius="2" Height="4"
                                    HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                        </Border>
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#8CF5F5F7" Margin="8,-3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Tokens}" FontSize="12.5" VerticalAlignment="Top"
                           HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Amount}" FontSize="12.5" VerticalAlignment="Top"
                           HorizontalAlignment="Right" MinWidth="62" TextAlignment="Right"
                           ToolTip="{Binding AmountTip}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部:区间 / 刷新 / 价目表来源 -->
        <Border DockPanel.Dock="Top" Background="#20202A" Padding="20,12" BorderBrush="#2E2E38" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SpanToday" Style="{StaticResource SpanToggle}" Content="今天" GroupName="Span" Tag="Today"/>
                    <RadioButton x:Name="SpanWeek" Style="{StaticResource SpanToggle}" Content="近 7 天" GroupName="Span" Tag="Week"/>
                    <RadioButton x:Name="SpanMonth" Style="{StaticResource SpanToggle}" Content="近 30 天" GroupName="Span" Tag="Month"/>
                    <RadioButton x:Name="SpanAll" Style="{StaticResource SpanToggle}" Content="全部" GroupName="Span" Tag="All"/>
                    <Button x:Name="RefreshButton" Style="{StaticResource DarkButton}" Content="重新读取" Click="Refresh_Click"/>
                </StackPanel>
                <TextBlock x:Name="PriceSourceText" Style="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel Margin="20,16,20,20">

                <!-- 总计 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TotalTokens" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
                            <TextBlock Text="tokens" FontSize="12" Foreground="#8CF5F5F7" Margin="7,0,0,7"/>
                            <TextBlock x:Name="TotalCost" FontSize="30" FontWeight="SemiBold" Margin="26,0,0,0" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBlock x:Name="CostNote" Style="{StaticResource Dim}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TallyLine" Style="{StaticResource Dim}" Margin="0,9,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ScopeLine" Style="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 每日柱状图 -->
                <TextBlock Text="每日用量" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}" Padding="14,12,14,8">
                    <StackPanel>
                        <Canvas x:Name="ChartCanvas" Height="132" ClipToBounds="True"/>
                        <TextBlock x:Name="ChartHint" Style="{StaticResource Dim}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 模型 -->
                <TextBlock Text="模型" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <ItemsControl x:Name="ModelList" ItemTemplate="{StaticResource RowTemplate}"/>
                </Border>
                <TextBlock x:Name="ModelHint" Style="{StaticResource Dim}" Margin="0,-6,0,14" TextWrapping="Wrap"/>

                <!-- 来源 -->
                <TextBlock Text="来源" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <ItemsControl x:Name="AgentList" ItemTemplate="{StaticResource RowTemplate}"/>
                </Border>

                <!-- 项目 -->
                <TextBlock Text="项目" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <ItemsControl x:Name="ProjectList" ItemTemplate="{StaticResource RowTemplate}"/>
                </Border>

                <!-- 最近会话 -->
                <TextBlock Text="最近会话" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <ItemsControl x:Name="SessionList" ItemTemplate="{StaticResource RowTemplate}"/>
                </Border>

                <TextBlock x:Name="Footnote" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
