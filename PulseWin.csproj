<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PulseWin</AssemblyName>
    <RootNamespace>PulseWin</RootNamespace>
    <!-- 更新检查要拿它和 GitHub 上的 tag 比 -->
    <Version>1.3.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 用量统计要读 SQLite(Microsoft.Data.Sqlite 带原生 e_sqlite3.dll);
         单文件发布必须让它自解压,否则运行时报"找不到指定的模块"。 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms 仅用于托盘/屏幕枚举,它的隐式 using 会与 WPF 类型冲突 -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\goat-white.png" />
    <Resource Include="Assets\opencode.svg" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内置模型牌价(从 models.dev 裁剪:第一方 + 套餐厂商,约 47KB)。
         运行时会被 Data\model-prices.json 的下载版覆盖。 -->
    <EmbeddedResource Include="Services\Spend\model-prices.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
